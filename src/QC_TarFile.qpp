#include "QC_TarFile.h"
#include "QoreTarFile.h"
#include "TarInputStream.h"
#include "TarOutputStream.h"
#include "QC_TarInputStream.h"
#include "QC_TarOutputStream.h"

/** @defgroup tar_compression_methods Tar Compression Methods
    These constants define the compression methods available for TAR archives.
*/
///@{
//! No compression (.tar)
const TAR_CM_NONE = 0;

//! Gzip compression (.tar.gz, .tgz)
const TAR_CM_GZIP = 1;

//! BZip2 compression (.tar.bz2)
const TAR_CM_BZIP2 = 2;

//! XZ/LZMA compression (.tar.xz)
const TAR_CM_XZ = 3;

//! Zstandard compression (.tar.zst)
const TAR_CM_ZSTD = 4;

//! LZ4 compression (.tar.lz4)
const TAR_CM_LZ4 = 5;
///@}

/** @defgroup tar_compression_levels Tar Compression Levels
    These constants define compression levels for TAR archives.
*/
///@{
//! Default compression level
const TAR_COMPRESSION_DEFAULT = -1;

//! Fastest compression
const TAR_COMPRESSION_FASTEST = 1;

//! Best (maximum) compression
const TAR_COMPRESSION_BEST = 9;
///@}

/** @defgroup tar_formats Tar Formats
    These constants define the TAR archive formats.
*/
///@{
//! POSIX.1-1988 ustar format
const TAR_FORMAT_USTAR = 0;

//! POSIX.1-2001 pax interchange format (default, most compatible)
const TAR_FORMAT_PAX = 1;

//! GNU tar format
const TAR_FORMAT_GNU = 2;

//! Old V7 tar format
const TAR_FORMAT_V7 = 3;
///@}

//! Information about a TAR archive entry
/** @since %tar 1.0
*/
hashdecl Qore::Tar::TarEntryInfo {
    //! The name/path of the entry within the archive
    string name;

    //! The uncompressed size of the entry in bytes
    int size;

    //! The last modification date and time
    date modified;

    //! The last access date and time (if available)
    *date accessed;

    //! The creation date and time (if available)
    *date created;

    //! Unix file mode/permissions
    int mode;

    //! User ID of the file owner
    int uid;

    //! Group ID of the file owner
    int gid;

    //! User name of the file owner (if available)
    *string uname;

    //! Group name of the file owner (if available)
    *string gname;

    //! Entry type: "file", "directory", "symlink", "hardlink", "chardev", "blockdev", "fifo", "socket"
    string type;

    //! Target path for symlinks and hardlinks
    *string link_target;

    //! True if this entry is a directory
    bool is_directory;

    //! True if this entry is a symbolic link
    bool is_symlink;

    //! True if this entry is a hard link
    bool is_hardlink;

    //! Device major number (for device nodes)
    *int devmajor;

    //! Device minor number (for device nodes)
    *int devminor;
}

//! Options for adding entries to a TAR archive
/** @since %tar 1.0
*/
hashdecl Qore::Tar::TarAddOptions {
    //! Override file permissions
    *int mode;

    //! Override user ID
    *int uid;

    //! Override group ID
    *int gid;

    //! Override user name
    *string uname;

    //! Override group name
    *string gname;

    //! Override modification time
    *date modified;

    //! Preserve original permissions (default: True)
    *bool preserve_permissions;

    //! Follow symlinks instead of storing them
    *bool dereference_symlinks;
}

//! Options for extracting entries from a TAR archive
/** @since %tar 1.0
*/
hashdecl Qore::Tar::TarExtractOptions {
    //! Base destination path for extraction
    *string destination;

    //! Restore file permissions (default: True)
    *bool preserve_permissions;

    //! Restore ownership (requires root, default: False)
    *bool preserve_ownership;

    //! Restore modification times (default: True)
    *bool preserve_times;

    //! Overwrite existing files (default: True)
    *bool overwrite;

    //! Create parent directories (default: True)
    *bool create_directories;

    //! Patterns to include (glob-style)
    *list<string> include;

    //! Patterns to exclude (glob-style)
    *list<string> exclude;

    //! Number of leading path components to strip from entry names during extraction
    /** For example, with strip_count = 1, the entry "project/src/main.c" becomes "src/main.c".
        Entries with fewer components than strip_count are skipped.
    */
    *int strip_count;
}

//! Options for creating a TAR archive
/** @since %tar 1.0
*/
hashdecl Qore::Tar::TarCreateOptions {
    //! Default compression method
    *int compression_method;

    //! Default compression level
    *int compression_level;

    //! TAR format to use
    *int format;
}

//! The TarFile class provides functionality for creating, reading, and modifying TAR archives
/**
    @par Example: Creating a TAR archive
    @code{.py}
#!/usr/bin/qore

%requires tar

TarFile tar("backup.tar.gz", "w");
tar.add("readme.txt", "Hello, World!");
tar.addFile("document.pdf", "/path/to/document.pdf");
tar.addDirectory("images/");
tar.close();
    @endcode

    @par Example: Reading a TAR archive
    @code{.py}
TarFile tar("backup.tar.gz", "r");
foreach hash<TarEntryInfo> entry in (tar.entries()) {
    printf("Entry: %s, Size: %d bytes\n", entry.name, entry.size);
}
binary data = tar.read("readme.txt");
tar.close();
    @endcode

    @par Example: Extracting a TAR archive
    @code{.py}
TarFile tar("backup.tar.gz", "r");
tar.extractAll("/destination/path", {"overwrite": True});
tar.close();
    @endcode

    @since %tar 1.0
*/
qclass TarFile [arg=QoreTarFile* tf; ns=Qore::Tar];

//! Creates a TarFile object for reading, writing, or appending to an archive
/** @param path the path to the TAR archive file
    @param mode the open mode: \c "r" for read, \c "w" for write (create/overwrite), \c "a" for append

    @throw TAR-ERROR error opening the archive

    @note Compression is auto-detected from the filename extension (e.g., .tar.gz, .tar.bz2, .tar.xz)
*/
TarFile::constructor(string path, string mode = "r") [dom=FILESYSTEM] {
    TarMode tm = TAR_MODE_READ;
    if (mode->empty() || mode->c_str()[0] == 'r') {
        tm = TAR_MODE_READ;
    } else if (mode->c_str()[0] == 'w') {
        tm = TAR_MODE_WRITE;
    } else if (mode->c_str()[0] == 'a') {
        tm = TAR_MODE_APPEND;
    } else {
        xsink->raiseException("TAR-ERROR", "invalid mode '%s'; must be 'r', 'w', or 'a'", mode->c_str());
        return;
    }

    ReferenceHolder<QoreTarFile> holder(new QoreTarFile(path->c_str(), tm, -1, -1, xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_TARFILE, holder.release());
}

//! Creates a TarFile object for reading, writing, or appending to an archive with options
/** @param path the path to the TAR archive file
    @param mode the open mode: \c "r" for read, \c "w" for write (create/overwrite), \c "a" for append
    @param options optional @ref TarCreateOptions for compression and format settings

    @throw TAR-ERROR error opening the archive
*/
TarFile::constructor(string path, string mode, *hash<TarCreateOptions> options) [dom=FILESYSTEM] {
    TarMode tm = TAR_MODE_READ;
    if (mode->empty() || mode->c_str()[0] == 'r') {
        tm = TAR_MODE_READ;
    } else if (mode->c_str()[0] == 'w') {
        tm = TAR_MODE_WRITE;
    } else if (mode->c_str()[0] == 'a') {
        tm = TAR_MODE_APPEND;
    } else {
        xsink->raiseException("TAR-ERROR", "invalid mode '%s'; must be 'r', 'w', or 'a'", mode->c_str());
        return;
    }

    int cm = -1;
    int fmt = -1;
    if (options) {
        QoreValue v = options->getKeyValue("compression_method");
        if (!v.isNothing()) {
            cm = (int)v.getAsBigInt();
        }
        v = options->getKeyValue("format");
        if (!v.isNothing()) {
            fmt = (int)v.getAsBigInt();
        }
    }

    ReferenceHolder<QoreTarFile> holder(new QoreTarFile(path->c_str(), tm, cm, fmt, xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_TARFILE, holder.release());
}

//! Creates a TarFile object from binary data (in-memory archive)
/** @param data binary data containing a TAR archive

    @throw TAR-ERROR error parsing the archive data
*/
TarFile::constructor(binary data) [flags=NAMED_ARGS] {
    ReferenceHolder<QoreTarFile> holder(new QoreTarFile(data, xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_TARFILE, holder.release());
}

//! Creates a new empty in-memory TAR archive
/** Use toData() to get the archive as binary data after adding entries.

    @param options optional @ref TarCreateOptions for compression and format settings
*/
TarFile::constructor(*hash<TarCreateOptions> options) [flags=NAMED_ARGS] {
    int cm = -1;
    int fmt = -1;
    if (options) {
        QoreValue v = options->getKeyValue("compression_method");
        if (!v.isNothing()) {
            cm = (int)v.getAsBigInt();
        }
        v = options->getKeyValue("format");
        if (!v.isNothing()) {
            fmt = (int)v.getAsBigInt();
        }
    }

    ReferenceHolder<QoreTarFile> holder(new QoreTarFile(cm, fmt, xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_TARFILE, holder.release());
}

//! Creates a TarFile object for reading from an InputStream
/** @param input the input stream to read archive data from

    @throw TAR-ERROR error reading the archive

    @note The input stream must remain valid for the lifetime of the TarFile object.
    Compression is auto-detected from the stream data.

    @warning Operations that require re-reading the archive (e.g. calling entries() followed by
    read()) will buffer the entire stream into memory on first use, since streams are not seekable.
    For truly large archives where memory is a concern, use the file-path constructor instead.

    @since %tar 1.1
*/
TarFile::constructor(Qore::InputStream[InputStream] input) [flags=NAMED_ARGS] {
    ReferenceHolder<QoreTarFile> holder(new QoreTarFile(*input, xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_TARFILE, holder.release());
}

//! Creates a TarFile object for writing to an OutputStream
/** @param output the output stream to write archive data to
    @param options optional @ref TarCreateOptions for compression and format settings

    @throw TAR-ERROR error opening the archive for writing

    @note The output stream must remain valid for the lifetime of the TarFile object.

    @since %tar 1.1
*/
TarFile::constructor(Qore::OutputStream[OutputStream] output, *hash<TarCreateOptions> options)
        [flags=NAMED_ARGS] {
    int cm = -1;
    int fmt = -1;
    if (options) {
        QoreValue v = options->getKeyValue("compression_method");
        if (!v.isNothing()) {
            cm = (int)v.getAsBigInt();
        }
        v = options->getKeyValue("format");
        if (!v.isNothing()) {
            fmt = (int)v.getAsBigInt();
        }
    }

    ReferenceHolder<QoreTarFile> holder(new QoreTarFile(*output,
        cm >= 0 ? cm : TAR_CM_NONE, fmt >= 0 ? fmt : TAR_FORMAT_PAX, xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_TARFILE, holder.release());
}

//! Destroys the object and closes the archive if still open
/**
*/
TarFile::destructor() {
    tf->close(xsink);
    tf->deref(xsink);
}

//! Closes the archive
/** @throw TAR-ERROR error closing the archive
*/
nothing TarFile::close() {
    tf->close(xsink);
}

//! Returns the archive as binary data (for in-memory archives)
/** @return the archive as binary data

    @throw TAR-ERROR error getting archive data or archive not in memory mode
*/
binary TarFile::toData() {
    return tf->toData(xsink);
}

//! Returns a list of all entries in the archive
/** @return a list of @ref TarEntryInfo hashes describing each entry

    @throw TAR-ERROR error reading archive entries
*/
list<hash<TarEntryInfo>> TarFile::entries() {
    return tf->entries(xsink);
}

//! Returns the number of entries in the archive
/** @return the number of entries

    @throw TAR-ERROR error reading archive
*/
int TarFile::entryCount() {
    return tf->count(xsink);
}

//! Checks if an entry exists in the archive
/** @param name the name of the entry to check

    @return True if the entry exists, False otherwise

    @throw TAR-ERROR error reading archive
*/
bool TarFile::hasEntry(string name) [flags=NAMED_ARGS] {
    return tf->hasEntry(name->c_str(), xsink);
}

//! Reads an entry from the archive as binary data
/** @param name the name of the entry to read

    @return the entry content as binary data

    @throw TAR-ERROR error reading entry or entry not found
*/
binary TarFile::read(string name) [flags=NAMED_ARGS] {
    return tf->read(name->c_str(), xsink);
}

//! Reads an entry from the archive as text
/** @param name the name of the entry to read
    @param encoding the character encoding to use (default: UTF-8)

    @return the entry content as a string

    @throw TAR-ERROR error reading entry or entry not found
*/
string TarFile::readText(string name, *string encoding) [flags=NAMED_ARGS] {
    return tf->readText(name->c_str(), encoding ? encoding->c_str() : nullptr, xsink);
}

//! Gets information about a specific entry
/** @param name the name of the entry

    @return a @ref TarEntryInfo hash describing the entry, or NOTHING if not found
*/
*hash<TarEntryInfo> TarFile::getEntry(string name) [flags=NAMED_ARGS] {
    return tf->getEntry(name->c_str(), xsink);
}

//! Adds binary data as an entry to the archive
/** @param name the name for the entry in the archive
    @param data the binary data to add
    @param options optional @ref TarAddOptions for metadata settings

    @throw TAR-ERROR error adding entry or archive not open for writing
*/
nothing TarFile::add(string name, binary data, *hash<TarAddOptions> options) [flags=NAMED_ARGS] {
    tf->add(name->c_str(), data, options, xsink);
}

//! Adds text as an entry to the archive
/** @param name the name for the entry in the archive
    @param text the text content to add
    @param encoding the character encoding to use (default: UTF-8)
    @param options optional @ref TarAddOptions for metadata settings

    @throw TAR-ERROR error adding entry or archive not open for writing
*/
nothing TarFile::add(string name, string text, *string encoding, *hash<TarAddOptions> options)
        [flags=NAMED_ARGS] {
    tf->addText(name->c_str(), text, encoding ? encoding->c_str() : nullptr, options, xsink);
}

//! Adds a file from the filesystem to the archive
/** @param archive_name the name for the entry in the archive
    @param source_path the path to the source file on disk
    @param options optional @ref TarAddOptions for metadata settings

    @throw TAR-ERROR error adding file or archive not open for writing
*/
nothing TarFile::addFile(string archive_name, string source_path, *hash<TarAddOptions> options)
        [dom=FILESYSTEM;flags=NAMED_ARGS] {
    tf->addFile(archive_name->c_str(), source_path->c_str(), options, xsink);
}

//! Adds a directory entry to the archive
/** @param name the name for the directory in the archive
    @param options optional @ref TarAddOptions for metadata settings

    @throw TAR-ERROR error adding directory or archive not open for writing
*/
nothing TarFile::addDirectory(string name, *hash<TarAddOptions> options) [flags=NAMED_ARGS] {
    tf->addDirectory(name->c_str(), options, xsink);
}

//! Adds a symbolic link entry to the archive
/** @param name the name for the symlink in the archive
    @param target the target path for the symlink
    @param options optional @ref TarAddOptions for metadata settings

    @throw TAR-ERROR error adding symlink or archive not open for writing
*/
nothing TarFile::addSymlink(string name, string target, *hash<TarAddOptions> options) [flags=NAMED_ARGS] {
    tf->addSymlink(name->c_str(), target->c_str(), options, xsink);
}

//! Adds a hard link entry to the archive
/** @param name the name for the hardlink in the archive
    @param target the target entry in the archive
    @param options optional @ref TarAddOptions for metadata settings

    @throw TAR-ERROR error adding hardlink or archive not open for writing
*/
nothing TarFile::addHardlink(string name, string target, *hash<TarAddOptions> options) [flags=NAMED_ARGS] {
    tf->addHardlink(name->c_str(), target->c_str(), options, xsink);
}

//! Extracts all entries to a destination directory
/** @param options optional @ref TarExtractOptions for extraction settings

    @return a list of entry names that were extracted (useful when include/exclude filters are active)

    @throw TAR-ERROR error extracting archive
*/
list<string> TarFile::extractAll(*hash<TarExtractOptions> options) [dom=FILESYSTEM] {
    std::string dest = ".";
    if (options) {
        QoreValue v = options->getKeyValue("destination");
        if (v.getType() == NT_STRING) {
            QoreStringValueHelper str(v);
            dest.assign(str->c_str(), str->size());
        }
    }
    return tf->extractAll(dest.c_str(), options, xsink);
}

//! Extracts all entries to a destination directory with a progress callback
/** @param options optional @ref TarExtractOptions for extraction settings
    @param progress a callback closure called after each entry is extracted with
    arguments \c (string entry_name, int current, int total) where \c current is
    the 1-based index and \c total is the total number of entries (-1 if unknown).
    If the callback throws an exception, extraction is aborted.

    @return a list of entry names that were extracted

    @throw TAR-ERROR error extracting archive

    @par Example:
    @code{.py}
TarFile tar("archive.tar.gz", "r");
tar.extractAll(opts, sub (string name, int cur, int total) {
    printf("[%d/%d] %s\n", cur, total, name);
});
    @endcode

    @since %tar 1.1
*/
list<string> TarFile::extractAll(*hash<TarExtractOptions> options, code progress) [dom=FILESYSTEM] {
    std::string dest = ".";
    if (options) {
        QoreValue v = options->getKeyValue("destination");
        if (v.getType() == NT_STRING) {
            QoreStringValueHelper str(v);
            dest.assign(str->c_str(), str->size());
        }
    }
    // Count entries first for total (cheap header-only pass)
    int64 total = tf->count(xsink);
    if (*xsink) {
        return QoreValue();
    }
    return tf->extractAll(dest.c_str(), options, xsink,
        const_cast<ResolvedCallReferenceNode*>(progress), total);
}

//! Extracts a single entry to a destination directory
/** @param name the name of the entry to extract
    @param options optional @ref TarExtractOptions for extraction settings

    @throw TAR-ERROR error extracting entry or entry not found
*/
nothing TarFile::extract(string name, *hash<TarExtractOptions> options) [dom=FILESYSTEM] {
    std::string dest = ".";
    if (options) {
        QoreValue v = options->getKeyValue("destination");
        if (v.getType() == NT_STRING) {
            QoreStringValueHelper str(v);
            dest.assign(str->c_str(), str->size());
        }
    }
    tf->extractEntry(name->c_str(), dest.c_str(), xsink);
}

//! Extracts a single entry to a specific file path
/** @param name the name of the entry to extract
    @param destination the destination file path

    @throw TAR-ERROR error extracting entry or entry not found
*/
nothing TarFile::extractTo(string name, string destination) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    tf->extractTo(name->c_str(), destination->c_str(), xsink);
}

//! Returns the archive file path (if opened from a file)
/** @return the file path, or NOTHING for in-memory archives
*/
*string TarFile::getPath() {
    return tf->getPath();
}

//! Returns the compression method used
/** @return the compression method constant, or NOTHING if unknown
*/
*int TarFile::getCompressionMethod() {
    int cm = tf->getCompressionMethod();
    if (cm < 0) {
        return QoreValue();
    }
    return cm;
}

//! Returns the archive format
/** @return the format constant, or NOTHING if unknown
*/
*int TarFile::getFormat() {
    int fmt = tf->getFormat();
    if (fmt < 0) {
        return QoreValue();
    }
    return fmt;
}

//! Opens an input stream for reading an entry
/** @param name the name of the entry to read

    @return a TarInputStream for reading the entry data

    @throw TAR-ERROR error opening stream or entry not found
*/
TarInputStream TarFile::getInputStream(string name) [flags=NAMED_ARGS] {
    return tf->openInputStream(name->c_str(), xsink);
}

//! Opens an output stream for writing an entry
/** @param name the name for the entry in the archive
    @param options optional @ref TarAddOptions for metadata settings

    @return a TarOutputStream for writing the entry data

    @throw TAR-ERROR error opening stream or archive not open for writing
*/
TarOutputStream TarFile::getOutputStream(string name, *hash<TarAddOptions> options) [flags=NAMED_ARGS] {
    return tf->openOutputStream(name->c_str(), options, xsink);
}

/** @defgroup tar_utility_functions Tar Utility Functions
    These functions provide name lookups for TAR constants.
*/
///@{

//! Returns the human-readable name of a compression method constant
/** @param method one of @ref tar_compression_methods (e.g. @ref TAR_CM_GZIP)

    @return the compression method name (e.g. \c "gzip"), or \c "unknown" for unrecognized values

    @par Example:
    @code{.py}
    string name = get_compression_name(TAR_CM_GZIP);  # returns "gzip"
    @endcode

    @since %tar 1.1
*/
string get_compression_name(int method) [flags=CONSTANT,NAMED_ARGS] {
    switch (method) {
        case 0: return new QoreStringNode("none");
        case 1: return new QoreStringNode("gzip");
        case 2: return new QoreStringNode("bzip2");
        case 3: return new QoreStringNode("xz");
        case 4: return new QoreStringNode("zstd");
        case 5: return new QoreStringNode("lz4");
        default: return new QoreStringNode("unknown");
    }
}

//! Returns the human-readable name of an archive format constant
/** @param format one of @ref tar_formats (e.g. @ref TAR_FORMAT_PAX)

    @return the format name (e.g. \c "pax"), or \c "unknown" for unrecognized values

    @par Example:
    @code{.py}
    string name = get_format_name(TAR_FORMAT_PAX);  # returns "pax"
    @endcode

    @since %tar 1.1
*/
string get_format_name(int format) [flags=CONSTANT,NAMED_ARGS] {
    switch (format) {
        case 0: return new QoreStringNode("ustar");
        case 1: return new QoreStringNode("pax");
        case 2: return new QoreStringNode("gnu");
        case 3: return new QoreStringNode("v7");
        default: return new QoreStringNode("unknown");
    }
}

///@}
