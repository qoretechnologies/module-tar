    }

    # Test encrypt/decrypt actions
    encryptDecryptActionTest() {
        AbstractDataProvider provider = DataProvider::getFactory("tar").create();

        AbstractDataProvider encryptProvider = provider.getChildProvider("archive").getChildProvider("encrypt");
        assertEq("encrypt", encryptProvider.getName(), "encrypt provider name");

        AbstractDataProvider decryptProvider = provider.getChildProvider("archive").getChildProvider("decrypt");
        assertEq("decrypt", decryptProvider.getName(), "decrypt provider name");

        hash<DataProviderInfo> encInfo = encryptProvider.getInfo();
        assertEq(True, encInfo.supports_request, "encrypt supports request");

        hash<DataProviderInfo> decInfo = decryptProvider.getInfo();
        assertEq(True, decInfo.supports_request, "decrypt supports request");

        # Create test archive
        AbstractDataProvider createProvider = provider.getChildProvider("archive").getChildProvider("create");
        hash<auto> create_result = createProvider.doRequest({
            "files": (
                {"name": "secret.txt", "text": "Top Secret Data"},
                {"name": "config.json", "text": "{\"key\": \"value\"}"},
            ),
        });
        binary original_data = create_result.archive_data;
        int original_size = original_data.size();

        # 32-byte key for AES-256
        binary key = <0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef>;

        # Test encrypt
        hash<auto> enc_result = encryptProvider.doRequest({
            "archive_data": original_data,
            "key": key,
        });

        assertEq(True, enc_result.encrypted_size > original_size,
            "encrypted size > original (includes IV + padding)");
        assertEq(original_size, enc_result.original_size,
            "original_size in response matches");
        assertEq(enc_result.encrypted_data.size(), enc_result.encrypted_size,
            "encrypted_size matches actual data size");
        # Encrypted data should differ from original
        assertEq(True, enc_result.encrypted_data != original_data,
            "encrypted data differs from original");

        # Test round-trip: decrypt
        hash<auto> dec_result = decryptProvider.doRequest({
            "encrypted_data": enc_result.encrypted_data,
            "key": key,
        });

        assertEq(original_data, dec_result.archive_data,
            "round-trip produces identical archive data");
        assertEq(original_size, dec_result.archive_size,
            "decrypted size matches original");

        # Verify the decrypted archive is valid
        AbstractDataProvider listProvider =
            provider.getChildProvider("archive").getChildProvider("list");
        hash<auto> list_result = listProvider.doRequest({
            "archive_data": dec_result.archive_data,
        });
        assertEq(2, list_result.count, "decrypted archive has 2 entries");

        # Test wrong key produces error
        binary wrong_key = <ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff>;
        assertThrows("DECRYPT-ERROR", sub() {
            decryptProvider.doRequest({
                "encrypted_data": enc_result.encrypted_data,
                "key": wrong_key,
            });
        }, NOTHING, "decrypt with wrong key fails");

        # Test wrong key size
        assertThrows("TAR-ERROR", sub() {
            encryptProvider.doRequest({
                "archive_data": original_data,
                "key": <0123456789abcdef>,
            });
        }, NOTHING, "encrypt rejects short key");

        assertThrows("TAR-ERROR", sub() {
            decryptProvider.doRequest({
                "encrypted_data": enc_result.encrypted_data,
                "key": <0123456789abcdef>,
            });
        }, NOTHING, "decrypt rejects short key");

        # Test encrypted data too short
        assertThrows("TAR-ERROR", sub() {
            decryptProvider.doRequest({
                "encrypted_data": <0123456789abcdef>,
                "key": key,
            });
        }, NOTHING, "decrypt rejects data shorter than IV + 1 block");

        # Test encrypt from file path
        {
            string archive_path = testDir + "/encrypt_test.tar";
            createProvider.doRequest({
                "archive_path": archive_path,
                "files": ({"name": "test.txt", "text": "test"},),
            });

            hash<auto> enc_from_file = encryptProvider.doRequest({
                "archive_path": archive_path,
                "key": key,
            });
            assertEq(True, enc_from_file.encrypted_size > 0,
                "encrypt from file produces output");

            # Round-trip
            hash<auto> dec_from_file = decryptProvider.doRequest({
                "encrypted_data": enc_from_file.encrypted_data,
                "key": key,
            });
            assertEq(enc_from_file.original_size, dec_from_file.archive_size,
                "file encrypt round-trip size matches");
        }

        # Test missing archive source
        assertThrows("REQUIRED-FIELD-GROUP-ERROR", sub() {
            encryptProvider.doRequest({"key": key});
        }, NOTHING, "encrypt requires archive source");

        assertThrows("REQUIRED-FIELD-GROUP-ERROR", sub() {
            decryptProvider.doRequest({"key": key});
        }, NOTHING, "decrypt requires encrypted source");

        # Test request/response types
        {
            *AbstractDataProviderType encReqType = encryptProvider.getRequestType();
            hash<string, AbstractDataField> encFields = encReqType.getFields();
            assertEq(True, exists encFields.key, "encrypt has key field");
            assertEq(True, exists encFields.archive_data, "encrypt has archive_data field");

            *AbstractDataProviderType decReqType = decryptProvider.getRequestType();
            hash<string, AbstractDataField> decFields = decReqType.getFields();
            assertEq(True, exists decFields.key, "decrypt has key field");
            assertEq(True, exists decFields.encrypted_data, "decrypt has encrypted_data field");
        }
    }

    # Test split/join actions
    splitJoinActionTest() {
        AbstractDataProvider provider = DataProvider::getFactory("tar").create();

        AbstractDataProvider splitProvider = provider.getChildProvider("archive").getChildProvider("split");
        assertEq("split", splitProvider.getName(), "split provider name");

        AbstractDataProvider joinProvider = provider.getChildProvider("archive").getChildProvider("join");
        assertEq("join", joinProvider.getName(), "join provider name");

        hash<DataProviderInfo> splitInfo = splitProvider.getInfo();
        assertEq(True, splitInfo.supports_request, "split supports request");

        hash<DataProviderInfo> joinInfo = joinProvider.getInfo();
        assertEq(True, joinInfo.supports_request, "join supports request");

        # Create a test archive for split/join round-trip
        AbstractDataProvider createProvider = provider.getChildProvider("archive").getChildProvider("create");
        hash<auto> create_result = createProvider.doRequest({
            "files": (
                {"name": "file1.txt", "text": "Hello World"},
                {"name": "file2.txt", "text": "Second file content"},
                {"name": "dir/nested.txt", "text": "Nested content"},
            ),
        });
        binary original_data = create_result.archive_data;
        int original_size = original_data.size();

        # Test split into chunks
        {
            hash<auto> split_result = splitProvider.doRequest({
                "archive_data": original_data,
                "chunk_size": 512,
            });

            assertEq(True, split_result.chunk_count > 1,
                "split produces multiple chunks");
            assertEq(original_size, split_result.total_size,
                "split total_size matches original");
            assertEq(split_result.chunks.size(), split_result.chunk_count,
                "chunk_count matches chunks list size");

            # Verify each chunk is at most chunk_size bytes
            foreach binary chunk in (split_result.chunks) {
                assertEq(True, chunk.size() <= 512, "chunk size <= 512");
            }

            # Test round-trip: join chunks back
            hash<auto> join_result = joinProvider.doRequest({
                "chunks": split_result.chunks,
            });

            assertEq(original_size, join_result.total_size,
                "join total_size matches original");
            assertEq(split_result.chunk_count, join_result.chunk_count,
                "join chunk_count matches split count");
            assertEq(original_data, join_result.archive_data,
                "round-trip produces identical binary");

            # Verify the joined archive is valid by listing contents
            AbstractDataProvider listProvider =
                provider.getChildProvider("archive").getChildProvider("list");
            hash<auto> list_result = listProvider.doRequest({
                "archive_data": join_result.archive_data,
            });
            assertEq(3, list_result.count, "joined archive has 3 entries");
        }

        # Test split with chunk_size larger than archive (single chunk)
        {
            hash<auto> split_result = splitProvider.doRequest({
                "archive_data": original_data,
                "chunk_size": original_size + 1000,
            });

            assertEq(1, split_result.chunk_count, "large chunk_size produces 1 chunk");
            assertEq(original_data, split_result.chunks[0],
                "single chunk equals original data");
        }

        # Test split with chunk_size == 1
        {
            # Use small data to avoid huge list
            binary small_data = binary("test");
            hash<auto> split_result = splitProvider.doRequest({
                "archive_data": small_data,
                "chunk_size": 1,
            });

            assertEq(4, split_result.chunk_count, "chunk_size=1 splits into 4 chunks");

            # Round-trip
            hash<auto> join_result = joinProvider.doRequest({
                "chunks": split_result.chunks,
            });
            assertEq(small_data, join_result.archive_data,
                "chunk_size=1 round-trip produces identical data");
        }

        # Test split from file path
        {
            string archive_path = testDir + "/split_test.tar";
            createProvider.doRequest({
                "archive_path": archive_path,
                "files": ({"name": "test.txt", "text": "test"},),
            });

            hash<auto> split_result = splitProvider.doRequest({
                "archive_path": archive_path,
                "chunk_size": 1024,
            });
            assertEq(True, split_result.chunk_count >= 1, "split from file works");
            assertEq(True, split_result.total_size > 0, "split from file has size");
        }

        # Test split with chunk_size <= 0 raises error
        assertThrows("TAR-ERROR", sub() {
            splitProvider.doRequest({
                "archive_data": original_data,
                "chunk_size": 0,
            });
        }, NOTHING, "split rejects chunk_size=0");

        assertThrows("TAR-ERROR", sub() {
            splitProvider.doRequest({
                "archive_data": original_data,
                "chunk_size": -1,
            });
        }, NOTHING, "split rejects chunk_size=-1");

        # Test split without archive source
        assertThrows("REQUIRED-FIELD-GROUP-ERROR", sub() {
            splitProvider.doRequest({
                "chunk_size": 512,
            });
        }, NOTHING, "split requires archive source");

        # Test join with empty chunks
        assertThrows("TAR-ERROR", sub() {
            joinProvider.doRequest({
                "chunks": (),
            });
        }, NOTHING, "join rejects empty chunks");

        # Test request/response types exist
        {
            *AbstractDataProviderType splitReqType = splitProvider.getRequestType();
            hash<string, AbstractDataField> splitFields = splitReqType.getFields();
            assertEq(True, exists splitFields.chunk_size, "split has chunk_size field");

            *AbstractDataProviderType joinReqType = joinProvider.getRequestType();
            hash<string, AbstractDataField> joinFields = joinReqType.getFields();
            assertEq(True, exists joinFields.chunks, "join has chunks field");
        }
    }

    # Test delete entry action
    deleteEntryActionTest() {
        AbstractDataProvider provider = DataProvider::getFactory("tar").create();
        AbstractDataProvider deleteProvider = provider.getChildProvider("entry").getChildProvider("delete");
        AbstractDataProvider createProvider = provider.getChildProvider("archive").getChildProvider("create");
        AbstractDataProvider listProvider = provider.getChildProvider("archive").getChildProvider("list");

        assertEq("delete", deleteProvider.getName(), "delete provider name");

        # Create a test archive with multiple entry types
        hash<auto> create_result = createProvider.doRequest({
            "files": (
                {"name": "file1.txt", "text": "First file"},
                {"name": "file2.txt", "text": "Second file"},
                {"name": "dir/nested.txt", "text": "Nested"},
            ),
        });
        binary original_data = create_result.archive_data;

        # Test delete middle entry
        {
            hash<auto> result = deleteProvider.doRequest({
                "archive_data": original_data,
                "entry_name": "file2.txt",
            });

            assertEq(True, result.deleted, "file2.txt deleted");
            assertEq(2, result.remaining_count, "2 entries remaining");
            assertEq(True, result.archive_size > 0, "output archive has data");

            # Verify the remaining archive contents
            hash<auto> list_result = listProvider.doRequest({
                "archive_data": result.archive_data,
            });
            assertEq(2, list_result.count, "remaining archive has 2 entries");
            list<string> names = (map $1.name, list_result.entries);
            assertEq(True, names.contains("file1.txt"), "file1.txt preserved");
            assertEq(True, names.contains("dir/nested.txt"), "dir/nested.txt preserved");
            assertEq(False, names.contains("file2.txt"), "file2.txt removed");

            # Verify content preserved
            AbstractDataProvider readProvider =
                provider.getChildProvider("file").getChildProvider("read");
            hash<auto> read_result = readProvider.doRequest({
                "archive_data": result.archive_data,
                "entry_name": "file1.txt",
                "as_text": True,
            });
            assertEq("First file", read_result.content, "file1.txt content preserved");
        }

        # Test delete non-existent entry
        {
            hash<auto> result = deleteProvider.doRequest({
                "archive_data": original_data,
                "entry_name": "nonexistent.txt",
            });

            assertEq(False, result.deleted, "non-existent entry not deleted");
            assertEq(3, result.remaining_count, "all 3 entries remain");
            assertEq(original_data, result.archive_data,
                "archive unchanged when entry not found");
        }

        # Test delete single entry (results in empty archive)
        {
            hash<auto> single_result = createProvider.doRequest({
                "files": ({"name": "only.txt", "text": "Only file"},),
            });

            hash<auto> result = deleteProvider.doRequest({
                "archive_data": single_result.archive_data,
                "entry_name": "only.txt",
            });

            assertEq(True, result.deleted, "only entry deleted");
            assertEq(0, result.remaining_count, "0 entries remaining");
        }

        # Test delete with compression option
        {
            hash<auto> result = deleteProvider.doRequest({
                "archive_data": original_data,
                "entry_name": "file1.txt",
                "compression": "gzip",
            });

            assertEq(True, result.deleted, "deleted with compression");
            assertEq(2, result.remaining_count, "2 entries remaining with compression");
        }

        # Test delete with empty entry_name
        assertThrows("ASSERTION-ERROR", sub() {
            deleteProvider.doRequest({
                "archive_data": original_data,
                "entry_name": "",
            });
        }, NOTHING, "delete rejects empty entry_name");

        # Test missing archive source
        assertThrows("REQUIRED-FIELD-GROUP-ERROR", sub() {
            deleteProvider.doRequest({"entry_name": "test.txt"});
        }, NOTHING, "delete requires archive source");

        # Test request/response types
        {
            *AbstractDataProviderType reqType = deleteProvider.getRequestType();
            hash<string, AbstractDataField> fields = reqType.getFields();
            assertEq(True, exists fields.entry_name, "delete has entry_name field");
            assertEq(True, exists fields.compression, "delete has compression field");
            assertEq(True, exists fields.format, "delete has format field");
        }
    }

    # Test archive directory action
    archiveDirectoryActionTest() {
        AbstractDataProvider provider = DataProvider::getFactory("tar").create();
        AbstractDataProvider archiveDirProvider =
            provider.getChildProvider("directory").getChildProvider("archive");

        assertEq("archive", archiveDirProvider.getName(), "archive dir provider name");

        # Create a test directory structure
        string srcDir = testDir + "/archive_src";
        mkdir(srcDir);
        mkdir(srcDir + "/subdir");
        mkdir(srcDir + "/subdir/nested");
        {
            File f();
            f.open(srcDir + "/root.txt", O_CREAT|O_WRONLY);
            f.write("Root file");
        }
        {
            File f();
            f.open(srcDir + "/subdir/child.txt", O_CREAT|O_WRONLY);
            f.write("Child file");
        }
        {
            File f();
            f.open(srcDir + "/subdir/nested/deep.txt", O_CREAT|O_WRONLY);
            f.write("Deep file");
        }

        # Test archive to binary data
        {
            hash<auto> result = archiveDirProvider.doRequest({
                "directory_path": srcDir,
            });

            assertEq(True, exists result.archive_data, "archive returns binary data");
            assertEq(True, result.entry_count > 0, "archive has entries");
            assertEq(3, result.file_count, "archive has 3 files");
            assertEq(True, result.directory_count >= 3, "archive has at least 3 dirs");
            assertEq("none", result.compression, "default compression is none");

            # Verify archive contents
            AbstractDataProvider listProvider =
                provider.getChildProvider("archive").getChildProvider("list");
            hash<auto> list_result = listProvider.doRequest({
                "archive_data": result.archive_data,
            });
            assertEq(result.entry_count, list_result.count, "list count matches entry_count");

            # Verify file content via extract
            AbstractDataProvider readProvider =
                provider.getChildProvider("file").getChildProvider("read");
            hash<auto> read_result = readProvider.doRequest({
                "archive_data": result.archive_data,
                "entry_name": "archive_src/root.txt",
                "as_text": True,
            });
            assertEq("Root file", read_result.content, "root.txt content preserved");

            hash<auto> deep_result = readProvider.doRequest({
                "archive_data": result.archive_data,
                "entry_name": "archive_src/subdir/nested/deep.txt",
                "as_text": True,
            });
            assertEq("Deep file", deep_result.content, "deep.txt content preserved");
        }

        # Test archive with custom base_name
        {
            hash<auto> result = archiveDirProvider.doRequest({
                "directory_path": srcDir,
                "base_name": "myproject",
            });

            AbstractDataProvider readProvider =
                provider.getChildProvider("file").getChildProvider("read");
            hash<auto> read_result = readProvider.doRequest({
                "archive_data": result.archive_data,
                "entry_name": "myproject/root.txt",
                "as_text": True,
            });
            assertEq("Root file", read_result.content,
                "custom base_name: root.txt accessible via myproject/root.txt");
        }

        # Test archive to file path
        {
            string out_path = testDir + "/dir_archive.tar";
            hash<auto> result = archiveDirProvider.doRequest({
                "directory_path": srcDir,
                "archive_path": out_path,
            });

            assertEq(out_path, result.archive_path, "archive_path in response");
            assertEq(True, is_file(out_path), "archive file created");
            assertEq(3, result.file_count, "file archive has 3 files");
        }

        # Test archive with compression
        {
            hash<auto> result = archiveDirProvider.doRequest({
                "directory_path": srcDir,
                "compression": "gzip",
            });

            assertEq("gzip", result.compression, "compression is gzip");
            assertEq(True, exists result.archive_data, "compressed archive has data");
        }

        # Test symlinks (without following)
        {
            string linkDir = testDir + "/link_src";
            mkdir(linkDir);
            {
                File f();
                f.open(linkDir + "/target.txt", O_CREAT|O_WRONLY);
                f.write("Target");
            }
            symlink(linkDir + "/target.txt", linkDir + "/link.txt");

            hash<auto> result = archiveDirProvider.doRequest({
                "directory_path": linkDir,
                "follow_symlinks": False,
            });

            assertEq(2, result.file_count, "symlink dir: 2 files (target + link)");
        }

        # Test empty directory
        {
            string emptyDir = testDir + "/empty_src";
            mkdir(emptyDir);

            hash<auto> result = archiveDirProvider.doRequest({
                "directory_path": emptyDir,
            });

            assertEq(0, result.file_count, "empty dir: 0 files");
            assertEq(1, result.directory_count, "empty dir: 1 directory entry");
        }

        # Test non-existent directory
        assertThrows("TAR-ERROR", sub() {
            archiveDirProvider.doRequest({
                "directory_path": testDir + "/nonexistent",
            });
        }, NOTHING, "non-existent directory rejected");

        # Test request type fields
        {
            *AbstractDataProviderType reqType = archiveDirProvider.getRequestType();
            hash<string, AbstractDataField> fields = reqType.getFields();
            assertEq(True, exists fields.directory_path, "has directory_path field");
            assertEq(True, exists fields.follow_symlinks, "has follow_symlinks field");
            assertEq(True, exists fields.base_name, "has base_name field");
        }
    }

    # Test stream extract action
    streamExtractActionTest() {
        AbstractDataProvider provider = DataProvider::getFactory("tar").create();
        AbstractDataProvider streamProvider =
            provider.getChildProvider("stream").getChildProvider("extract");

        assertEq("extract", streamProvider.getName(), "stream extract provider name");

        # Create a test archive with known content
        AbstractDataProvider createProvider = provider.getChildProvider("archive").getChildProvider("create");
        string test_content = strmul("Hello Stream World! ", 100);
        hash<auto> create_result = createProvider.doRequest({
            "files": (
                {"name": "large.txt", "text": test_content},
                {"name": "small.txt", "text": "Small"},
            ),
        });
        binary archive_data = create_result.archive_data;

        # Test streaming read
        {
            hash<auto> result = streamProvider.doRequest({
                "archive_data": archive_data,
                "entry_name": "large.txt",
            });

            assertEq("large.txt", result.entry_name, "stream entry_name matches");
            assertEq(test_content.size(), result.size, "stream size matches content length");
            assertEq(True, exists result.stream, "stream object returned");
            assertEq(True, exists result.tar_file, "tar_file reference returned");

            # Read the stream in chunks and verify content
            binary accumulated = binary();
            while (True) {
                *binary chunk = result.stream.read(256);
                if (!chunk) {
                    break;
                }
                accumulated += chunk;
            }
            assertEq(test_content.size(), accumulated.size(),
                "streamed data size matches original");
            assertEq(test_content, accumulated.toString(),
                "streamed data content matches original");
        }

        # Test stream from file path
        {
            string archive_path = testDir + "/stream_test.tar";
            createProvider.doRequest({
                "archive_path": archive_path,
                "files": ({"name": "test.txt", "text": "File Stream Test"},),
            });

            hash<auto> result = streamProvider.doRequest({
                "archive_path": archive_path,
                "entry_name": "test.txt",
            });

            assertEq("test.txt", result.entry_name, "file stream entry_name");
            *binary data = result.stream.read(4096);
            assertEq("File Stream Test", data.toString(),
                "file stream content matches");
        }

        # Test non-existent entry
        assertThrows("TAR-ERROR", sub() {
            streamProvider.doRequest({
                "archive_data": archive_data,
                "entry_name": "nonexistent.txt",
            });
        }, NOTHING, "stream extract rejects non-existent entry");

        # Test empty entry_name
        assertThrows("ASSERTION-ERROR", sub() {
            streamProvider.doRequest({
                "archive_data": archive_data,
                "entry_name": "",
            });
        }, NOTHING, "stream extract rejects empty entry_name");

        # Test missing archive source
        assertThrows("REQUIRED-FIELD-GROUP-ERROR", sub() {
            streamProvider.doRequest({"entry_name": "test.txt"});
        }, NOTHING, "stream extract requires archive source");

        # Test request/response types
        {
            *AbstractDataProviderType reqType = streamProvider.getRequestType();
            hash<string, AbstractDataField> fields = reqType.getFields();
            assertEq(True, exists fields.entry_name, "has entry_name field");

            *AbstractDataProviderType respType = streamProvider.getResponseType();
            hash<string, AbstractDataField> respFields = respType.getFields();
            assertEq(True, exists respFields.stream, "response has stream field");
            assertEq(True, exists respFields.tar_file, "response has tar_file field");
        }
    }

    # Test error handling
    errorHandlingTest() {
        AbstractDataProvider provider = DataProvider::getFactory("tar").create();

        # Test getting non-existent child
        *AbstractDataProvider nonExistent = provider.getChildProvider("nonexistent");
        assertEq(NOTHING, nonExistent, "non-existent child returns NOTHING");

        # Test getting non-existent grandchild
        AbstractDataProvider archiveProvider = provider.getChildProvider("archive");
        *AbstractDataProvider nonExistentAction = archiveProvider.getChildProvider("nonexistent");
        assertEq(NOTHING, nonExistentAction, "non-existent action returns NOTHING");
    }

    # Test enum functionality
    enumFunctionalityTest() {
        # Test TarCompression enum values equal their string equivalents
        assertEq("none", TarDataProvider::TarCompression::None, "TarCompression::None equals 'none'");
        assertEq("gzip", TarDataProvider::TarCompression::Gzip, "TarCompression::Gzip equals 'gzip'");
        assertEq("bzip2", TarDataProvider::TarCompression::Bzip2, "TarCompression::Bzip2 equals 'bzip2'");
        assertEq("xz", TarDataProvider::TarCompression::Xz, "TarCompression::Xz equals 'xz'");
        assertEq("zstd", TarDataProvider::TarCompression::Zstd, "TarCompression::Zstd equals 'zstd'");
        assertEq("lz4", TarDataProvider::TarCompression::Lz4, "TarCompression::Lz4 equals 'lz4'");

        # Test TarFormat enum values equal their string equivalents
        assertEq("ustar", TarDataProvider::TarFormat::Ustar, "TarFormat::Ustar equals 'ustar'");
        assertEq("pax", TarDataProvider::TarFormat::Pax, "TarFormat::Pax equals 'pax'");
        assertEq("gnu", TarDataProvider::TarFormat::Gnu, "TarFormat::Gnu equals 'gnu'");
        assertEq("v7", TarDataProvider::TarFormat::V7, "TarFormat::V7 equals 'v7'");

        # Test AllowedCompressionValues constant (AllowedValueInfo hashes)
        assertEq(6, TarDataProvider::AllowedCompressionValues.size(), "AllowedCompressionValues has 6 values");
        list<string> comprValues = extractAllowedValues(TarDataProvider::AllowedCompressionValues);
        assertEq(True, comprValues.contains("none"), "AllowedCompressionValues contains 'none'");
        assertEq(True, comprValues.contains("gzip"), "AllowedCompressionValues contains 'gzip'");

        # Test AllowedFormatValues constant (AllowedValueInfo hashes)
        assertEq(4, TarDataProvider::AllowedFormatValues.size(), "AllowedFormatValues has 4 values");
        list<string> fmtValues = extractAllowedValues(TarDataProvider::AllowedFormatValues);
        assertEq(True, fmtValues.contains("pax"), "AllowedFormatValues contains 'pax'");

        # Test AllowedEncodingValues constant (AllowedValueInfo hashes)
        assertEq(7, TarDataProvider::AllowedEncodingValues.size(), "AllowedEncodingValues has 7 values");
        list<string> encValues = extractAllowedValues(TarDataProvider::AllowedEncodingValues);
        assertEq(True, encValues.contains("UTF-8"), "AllowedEncodingValues contains 'UTF-8'");

        # Test getCompressionMethod() works with enum values
        assertEq(TAR_CM_NONE, TarDataProvider::getCompressionMethod(TarDataProvider::TarCompression::None),
            "getCompressionMethod with enum None");
        assertEq(TAR_CM_GZIP, TarDataProvider::getCompressionMethod(TarDataProvider::TarCompression::Gzip),
            "getCompressionMethod with enum Gzip");
        assertEq(TAR_CM_BZIP2, TarDataProvider::getCompressionMethod(TarDataProvider::TarCompression::Bzip2),
            "getCompressionMethod with enum Bzip2");
        assertEq(TAR_CM_XZ, TarDataProvider::getCompressionMethod(TarDataProvider::TarCompression::Xz),
            "getCompressionMethod with enum Xz");
        assertEq(TAR_CM_ZSTD, TarDataProvider::getCompressionMethod(TarDataProvider::TarCompression::Zstd),
            "getCompressionMethod with enum Zstd");
        assertEq(TAR_CM_LZ4, TarDataProvider::getCompressionMethod(TarDataProvider::TarCompression::Lz4),
            "getCompressionMethod with enum Lz4");

        # Test getCompressionMethod() works with string values
        assertEq(TAR_CM_NONE, TarDataProvider::getCompressionMethod("none"),
            "getCompressionMethod with string 'none'");
        assertEq(TAR_CM_GZIP, TarDataProvider::getCompressionMethod("gzip"),
            "getCompressionMethod with string 'gzip'");

        # Test getTarFormat() works with enum values
        assertEq(TAR_FORMAT_USTAR, TarDataProvider::getTarFormat(TarDataProvider::TarFormat::Ustar),
            "getTarFormat with enum Ustar");
        assertEq(TAR_FORMAT_PAX, TarDataProvider::getTarFormat(TarDataProvider::TarFormat::Pax),
            "getTarFormat with enum Pax");
        assertEq(TAR_FORMAT_GNU, TarDataProvider::getTarFormat(TarDataProvider::TarFormat::Gnu),
            "getTarFormat with enum Gnu");
        assertEq(TAR_FORMAT_V7, TarDataProvider::getTarFormat(TarDataProvider::TarFormat::V7),
            "getTarFormat with enum V7");

        # Test getTarFormat() works with string values
        assertEq(TAR_FORMAT_PAX, TarDataProvider::getTarFormat("pax"),
            "getTarFormat with string 'pax'");
        assertEq(TAR_FORMAT_GNU, TarDataProvider::getTarFormat("gnu"),
            "getTarFormat with string 'gnu'");

        # Test default values for NOTHING input
        assertEq(TAR_CM_NONE, TarDataProvider::getCompressionMethod(NOTHING),
            "getCompressionMethod with NOTHING returns TAR_CM_NONE");
        assertEq(TAR_FORMAT_PAX, TarDataProvider::getTarFormat(NOTHING),
            "getTarFormat with NOTHING returns TAR_FORMAT_PAX");
    }

    # Test assert error conditions
    assertErrorConditionTest() {
        AbstractDataProvider provider = DataProvider::getFactory("tar").create();

        # Test TarReadFileDataProvider throws REQUIRED-FIELD-GROUP-ERROR without archive source
        # setRequiredGroups validates that one of archive_path/archive_data/archive_location is provided
        AbstractDataProvider readProvider = provider.getChildProvider("file").getChildProvider("read");
        assertThrows("REQUIRED-FIELD-GROUP-ERROR", sub() {
            readProvider.doRequest({"entry_name": "test.txt"});
        }, NOTHING, "TarReadFile requires archive source");

        # Test TarReadFileDataProvider throws ASSERTION-ERROR with empty entry_name
        assertThrows("ASSERTION-ERROR", sub() {
            readProvider.doRequest({"archive_data": <00>, "entry_name": ""});
        }, NOTHING, "TarReadFile requires non-empty entry_name");

        # Test TarDecompressDataDataProvider throws REQUIRED-FIELD-GROUP-ERROR without archive source
        # setRequiredGroups validates that one of archive_data/archive_path/archive_location is provided
        AbstractDataProvider decompressProvider = provider.getChildProvider("data").getChildProvider("decompress");
        assertThrows("REQUIRED-FIELD-GROUP-ERROR", sub() {
            decompressProvider.doRequest({});
        }, NOTHING, "TarDecompress requires archive source");

        # Test TarCreateArchiveDataProvider throws ASSERTION-ERROR when require_entries=true and no entries
        AbstractDataProvider createProvider = provider.getChildProvider("archive").getChildProvider("create");
        assertThrows("ASSERTION-ERROR", sub() {
            createProvider.doRequest({"require_entries": True});
        }, NOTHING, "TarCreateArchive requires files or directories when require_entries=true");

        # Test TarCreateArchiveDataProvider allows empty archive when require_entries=false (default)
        hash<auto> emptyResult = createProvider.doRequest({});
        assertEq(0, emptyResult.entry_count, "empty archive has 0 entries");
        assertEq(True, exists emptyResult.archive_data, "empty archive returns binary data");

        # Test TarExtractFileDataProvider throws ASSERTION-ERROR with empty entry_name
        # entry_name is StringType but assert checks for non-empty
        AbstractDataProvider extractFileProvider = provider.getChildProvider("file").getChildProvider("extract");
        assertThrows("ASSERTION-ERROR", sub() {
            extractFileProvider.doRequest({"archive_data": <00>, "entry_name": ""});
        }, NOTHING, "TarExtractFile requires non-empty entry_name");

        # Test TarExtractFileDataProvider throws REQUIRED-FIELD-GROUP-ERROR without archive source
        # setRequiredGroups validates that one of archive_path/archive_data/archive_location is provided
        assertThrows("REQUIRED-FIELD-GROUP-ERROR", sub() {
            extractFileProvider.doRequest({"entry_name": "test.txt"});
        }, NOTHING, "TarExtractFile requires archive source");
    }

    # Helper to extract values from allowed_values list
    private list<string> extractAllowedValues(list<auto> allowedValues) {
        list<string> values = ();
        foreach hash<auto> av in (allowedValues) {
            values += av.value;
        }
        return values;
    }

    # Test allowed values validation
    allowedValuesTest() {
        AbstractDataProvider provider = DataProvider::getFactory("tar").create();

        # Test create provider has allowed_values for compression
        AbstractDataProvider createProvider = provider.getChildProvider("archive").getChildProvider("create");
        *AbstractDataProviderType reqType = createProvider.getRequestType();
        hash<string, AbstractDataField> fields = reqType.getFields();

        assertEq(True, exists fields.compression, "create provider has compression field");
        list<auto> compressionAllowed = fields.compression.getInfo().allowed_values;
        assertEq(6, compressionAllowed.size(), "compression has 6 allowed values");
        list<string> compressionValues = extractAllowedValues(compressionAllowed);
        assertEq(True, compressionValues.contains("none"), "compression allows 'none'");
        assertEq(True, compressionValues.contains("gzip"), "compression allows 'gzip'");
        assertEq(True, compressionValues.contains("bzip2"), "compression allows 'bzip2'");
        assertEq(True, compressionValues.contains("xz"), "compression allows 'xz'");
        assertEq(True, compressionValues.contains("zstd"), "compression allows 'zstd'");
        assertEq(True, compressionValues.contains("lz4"), "compression allows 'lz4'");

        # Test create provider has allowed_values for format
        assertEq(True, exists fields.format, "create provider has format field");
        list<auto> formatAllowed = fields.format.getInfo().allowed_values;
        assertEq(4, formatAllowed.size(), "format has 4 allowed values");
        list<string> formatValues = extractAllowedValues(formatAllowed);
        assertEq(True, formatValues.contains("ustar"), "format allows 'ustar'");
        assertEq(True, formatValues.contains("pax"), "format allows 'pax'");
        assertEq(True, formatValues.contains("gnu"), "format allows 'gnu'");
        assertEq(True, formatValues.contains("v7"), "format allows 'v7'");

        # Test add provider has allowed_values for compression and format
        AbstractDataProvider addProvider = provider.getChildProvider("archive").getChildProvider("add");
        *AbstractDataProviderType addReqType = addProvider.getRequestType();
        hash<string, AbstractDataField> addFields = addReqType.getFields();

        assertEq(True, exists addFields.compression, "add provider has compression field");
        assertEq(6, addFields.compression.getInfo().allowed_values.size(), "add compression has 6 allowed values");

        assertEq(True, exists addFields.format, "add provider has format field");
        assertEq(4, addFields.format.getInfo().allowed_values.size(), "add format has 4 allowed values");

        # Test compress provider has allowed_values for compression and format
        AbstractDataProvider compressProvider = provider.getChildProvider("data").getChildProvider("compress");
        *AbstractDataProviderType compressReqType = compressProvider.getRequestType();
        hash<string, AbstractDataField> compressFields = compressReqType.getFields();

        assertEq(True, exists compressFields.compression, "compress provider has compression field");
        assertEq(6, compressFields.compression.getInfo().allowed_values.size(), "compress compression has 6 allowed values");

        assertEq(True, exists compressFields.format, "compress provider has format field");
        assertEq(4, compressFields.format.getInfo().allowed_values.size(), "compress format has 4 allowed values");

        # Test read provider has allowed_values for encoding
        AbstractDataProvider readProvider = provider.getChildProvider("file").getChildProvider("read");
        *AbstractDataProviderType readReqType = readProvider.getRequestType();
        hash<string, AbstractDataField> readFields = readReqType.getFields();

        assertEq(True, exists readFields.encoding, "read provider has encoding field");
        list<auto> encodingAllowed = readFields.encoding.getInfo().allowed_values;
        assertEq(7, encodingAllowed.size(), "encoding has 7 allowed values");
        list<string> encodingValues = extractAllowedValues(encodingAllowed);
        assertEq(True, encodingValues.contains("UTF-8"), "encoding allows 'UTF-8'");
        assertEq(True, encodingValues.contains("ISO-8859-1"), "encoding allows 'ISO-8859-1'");
        assertEq(True, encodingValues.contains("ASCII"), "encoding allows 'ASCII'");
        assertEq(True, encodingValues.contains("UTF-16"), "encoding allows 'UTF-16'");
        assertEq(True, encodingValues.contains("UTF-16BE"), "encoding allows 'UTF-16BE'");
        assertEq(True, encodingValues.contains("UTF-16LE"), "encoding allows 'UTF-16LE'");
        assertEq(True, encodingValues.contains("Windows-1252"), "encoding allows 'Windows-1252'");
    }

    # Test location input/output support
    locationInputTest() {
        AbstractDataProvider provider = DataProvider::getFactory("tar").create();

        # Create a test archive file to use as source
        string archive_path = testDir + "/location_test.tar";
        AbstractDataProvider createProvider = provider.getChildProvider("archive").getChildProvider("create");
        hash<auto> create_response = createProvider.doRequest({
            "archive_path": archive_path,
            "files": (
                {"name": "hello.txt", "text": "Hello Location"},
                {"name": "data.bin", "data": binary("binary data")},
            ),
        });
        assertEq(2, create_response.entry_count, "create test archive");

        string file_location = "file://" + archive_path;

        # Test 1: List archive with location input
        AbstractDataProvider listProvider = provider.getChildProvider("archive").getChildProvider("list");
        hash<auto> list_response = listProvider.doRequest({
            "archive_location": file_location,
        });
        assertEq(2, list_response.count, "location input list count");

        # Test 2: Archive info with location input
        AbstractDataProvider infoProvider = provider.getChildProvider("archive").getChildProvider("info");
        hash<auto> info_response = infoProvider.doRequest({
            "archive_location": file_location,
        });
        assertEq(2, info_response.entry_count, "location input info count");
        assertEq(2, info_response.file_count, "location input info file count");

        # Test 3: Read file with location input
        AbstractDataProvider readProvider = provider.getChildProvider("file").getChildProvider("read");
        hash<auto> read_response = readProvider.doRequest({
            "archive_location": file_location,
            "entry_name": "hello.txt",
            "as_text": True,
        });
        assertEq("Hello Location", read_response.content, "location input read content");

        # Test 4: Extract archive with location input
        string extract_dir = testDir + "/location_extract";
        mkdir(extract_dir);
        AbstractDataProvider extractProvider = provider.getChildProvider("archive").getChildProvider("extract");
        hash<auto> extract_response = extractProvider.doRequest({
            "archive_location": file_location,
            "destination": extract_dir,
            "overwrite": True,
        });
        assertEq(2, extract_response.extracted_count, "location input extract count");

        # Test 5: Extract single file with location input
        string extract_file_path = testDir + "/location_extract_hello.txt";
        AbstractDataProvider extractFileProvider = provider.getChildProvider("file").getChildProvider("extract");
        hash<auto> extract_file_response = extractFileProvider.doRequest({
            "archive_location": file_location,
            "entry_name": "hello.txt",
            "destination": extract_file_path,
        });
        assertEq("hello.txt", extract_file_response.entry_name, "location input extract file entry name");

        # Test 6: Decompress with location input
        AbstractDataProvider decompressProvider = provider.getChildProvider("data").getChildProvider("decompress");
        hash<auto> decompress_response = decompressProvider.doRequest({
            "archive_location": file_location,
        });
        assertEq(2, decompress_response.file_count, "location input decompress file count");

        # Test 7: Create archive with output_location
        string output_loc_path = testDir + "/location_output.tar";
        string output_location = "file://" + output_loc_path;
        hash<auto> create_loc_response = createProvider.doRequest({
            "output_location": output_location,
            "files": (
                {"name": "out.txt", "text": "Output location test"},
            ),
        });
        assertEq(1, create_loc_response.entry_count, "output_location create count");
        assertEq(output_location, create_loc_response.output_location, "output_location matches");
        assertTrue(is_file(output_loc_path), "output_location file created");

        # Verify the output_location archive
        hash<auto> verify_response = listProvider.doRequest({
            "archive_path": output_loc_path,
        });
        assertEq(1, verify_response.count, "output_location archive has 1 entry");
    }
%endif
}
