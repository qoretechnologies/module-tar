# minimum required Qore version
%requires qore >= 2.0

%requires(reexport) DataProvider
%requires FileLocationHandler
%requires Mime
%requires tar

%modern

module TarDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for TAR archives";
    author = "Qore Technologies, s.r.o.";
    url = "https://github.com/qorelanguage/module-tar";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new TarDataProviderFactory());

        # Register the data provider application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": TarDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "TAR Archives",
            "short_desc": "TAR archive operations",
            "desc": "Create, extract, and manage TAR archives with support for gzip, bzip2, xz, and zstd compression",
            "groups": (DataProvider::AppGroup::DataTransformation,),
            "logo": TarLogo,
            "logo_file_name": "tar-logo.svg",
            "logo_mime_type": MimeTypeSvg,
        });

        # Register actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": TarDataProvider::AppName,
            "path": "/archive/create",
            "action": "create-archive",
            "display_name": "Create Archive",
            "short_desc": "Create a new tar archive",
            "desc": "Create a new tar archive from files, directories, or binary data with optional "
                "compression and format settings",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TarCreateArchiveRequestDataType::Fields{"archive_path", "output_location",
                    "compression", "files"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                TarCreateArchiveRequestDataType::Fields
                    - ("archive_path", "output_location", "compression", "files"),
            ),
            "output_type": TarCreateArchiveDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": TarDataProvider::AppName,
            "path": "/archive/extract",
            "action": "extract-archive",
            "display_name": "Extract Archive",
            "short_desc": "Extract a tar archive with optional filters",
            "desc": "Extract contents of a tar archive to a destination directory with optional "
                "`include`/`exclude` glob-style filename filters",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TarExtractArchiveRequestDataType::Fields{"archive_path", "archive_data",
                    "archive_location", "destination"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                TarExtractArchiveRequestDataType::Fields{"include", "exclude"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                TarExtractArchiveRequestDataType::Fields
                    - ("archive_path", "archive_data", "archive_location", "destination",
                       "include", "exclude"),
            ),
            "output_type": TarExtractArchiveDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": TarDataProvider::AppName,
            "path": "/archive/list",
            "action": "list-archive",
            "display_name": "List Archive Contents",
            "short_desc": "List files in a tar archive",
            "desc": "Get a list of all entries in a tar archive with metadata",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TarListRequestDataType::Fields, {
                    "preselected": True,
                },
            ),
            "output_type": TarListArchiveDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": TarDataProvider::AppName,
            "path": "/archive/info",
            "action": "get-archive-info",
            "display_name": "Get Archive Info",
            "short_desc": "Get tar archive metadata",
            "desc": "Get metadata and statistics about a tar archive including entry counts, "
                "compression method, and total size",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TarArchiveInfoRequestDataType::Fields, {
                    "preselected": True,
                },
            ),
            "output_type": TarArchiveInfoDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": TarDataProvider::AppName,
            "path": "/archive/add",
            "action": "add-files",
            "display_name": "Add Files to Archive",
            "short_desc": "Add files to an existing archive",
            "desc": "Add new files or update existing files in a tar archive",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TarAddFilesRequestDataType::Fields{"archive_path", "files"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                TarAddFilesRequestDataType::Fields - ("archive_path", "files"),
            ),
            "output_type": TarAddFilesDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": TarDataProvider::AppName,
            "path": "/file/extract",
            "action": "extract-file",
            "display_name": "Extract Single File",
            "short_desc": "Extract one file from archive",
            "desc": "Extract a single file from a tar archive to a destination path on disk",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TarExtractFileRequestDataType::Fields, {
                    "preselected": True,
                },
            ),
            "output_type": TarExtractFileDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": TarDataProvider::AppName,
            "path": "/file/read",
            "action": "read-file",
            "display_name": "Read File Content",
            "short_desc": "Read file without extracting",
            "desc": "Read the contents of a file from a tar archive without extracting to disk",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TarReadFileRequestDataType::Fields{"archive_path", "archive_data",
                    "archive_location", "entry_name", "as_text"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                TarReadFileRequestDataType::Fields{"encoding",},
            ),
            "output_type": TarReadFileDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": TarDataProvider::AppName,
            "path": "/data/compress",
            "action": "compress-data",
            "display_name": "Compress Data",
            "short_desc": "Compress data to tar format",
            "desc": "Compress binary data or files into an in-memory tar archive",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TarCompressDataRequestDataType::Fields{"compression", "files"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                TarCompressDataRequestDataType::Fields{"format",},
            ),
            "output_type": TarCompressDataDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": TarDataProvider::AppName,
            "path": "/data/decompress",
            "action": "decompress-data",
            "display_name": "Decompress Data",
            "short_desc": "Decompress tar data",
            "desc": "Decompress a tar archive and return file contents as in-memory data",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TarDecompressDataRequestDataType::Fields, {
                    "preselected": True,
                },
            ),
            "output_type": TarDecompressDataDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": TarDataProvider::AppName,
            "path": "/directory/archive",
            "action": "archive-directory",
            "display_name": "Archive Directory",
            "short_desc": "Archive a directory tree",
            "desc": "Recursively archive a directory tree into a tar archive, preserving file "
                "permissions and optionally following symlinks",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TarArchiveDirectoryRequestDataType::Fields{"directory_path", "archive_path",
                    "compression"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                TarArchiveDirectoryRequestDataType::Fields
                    - ("directory_path", "archive_path", "compression"),
            ),
            "output_type": TarArchiveDirectoryDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": TarDataProvider::AppName,
            "path": "/stream/extract",
            "action": "stream-extract",
            "display_name": "Stream Extract",
            "short_desc": "Stream extract file from archive",
            "desc": "Open a streaming input for reading a file from a tar archive without "
                "loading the entire file into memory",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TarStreamExtractRequestDataType::Fields, {
                    "preselected": True,
                },
            ),
            "output_type": TarStreamExtractDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": TarDataProvider::AppName,
            "path": "/entry/delete",
            "action": "delete-entry",
            "display_name": "Delete Entry",
            "short_desc": "Delete entry from archive",
            "desc": "Delete a file or directory entry from a tar archive by recreating the "
                "archive without the specified entry",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TarDeleteEntryRequestDataType::Fields{"archive_data", "archive_path",
                    "archive_location", "entry_name"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                TarDeleteEntryRequestDataType::Fields - ("archive_data", "archive_path",
                    "archive_location", "entry_name"),
            ),
            "output_type": TarDeleteEntryDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": TarDataProvider::AppName,
            "path": "/archive/verify",
            "action": "verify-archive",
            "display_name": "Verify Archive",
            "short_desc": "Verify archive integrity",
            "desc": "Verify the integrity of a tar archive by reading all entries and their "
                "data blocks without extracting to disk",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TarVerifyArchiveRequestDataType::Fields, {
                    "preselected": True,
                },
            ),
            "output_type": TarVerifyArchiveDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": TarDataProvider::AppName,
            "path": "/archive/encrypt",
            "action": "encrypt-archive",
            "display_name": "Encrypt Archive",
            "short_desc": "Encrypt a tar archive with AES-256-CBC",
            "desc": "Encrypt a tar archive with AES-256-CBC. Output format is a `16`-byte "
                "random IV followed by ciphertext",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TarEncryptArchiveRequestDataType::Fields, {
                    "preselected": True,
                },
            ),
            "output_type": TarEncryptArchiveDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": TarDataProvider::AppName,
            "path": "/archive/decrypt",
            "action": "decrypt-archive",
            "display_name": "Decrypt Archive",
            "short_desc": "Decrypt an AES-256-CBC encrypted tar archive",
            "desc": "Decrypt a tar archive encrypted with AES-256-CBC. Expects the IV + "
                "ciphertext format produced by the **encrypt** action",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TarDecryptArchiveRequestDataType::Fields, {
                    "preselected": True,
                },
            ),
            "output_type": TarDecryptArchiveDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": TarDataProvider::AppName,
            "path": "/archive/split",
            "action": "split-archive",
            "display_name": "Split Archive",
            "short_desc": "Split archive into fixed-size chunks",
            "desc": "Split a tar archive into multiple fixed-size binary chunks for multi-volume "
                "storage or transfer",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TarSplitArchiveRequestDataType::Fields, {
                    "preselected": True,
                },
            ),
            "output_type": TarSplitArchiveDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": TarDataProvider::AppName,
            "path": "/archive/join",
            "action": "join-archive",
            "display_name": "Join Archive Chunks",
            "short_desc": "Join archive chunks into single archive",
            "desc": "Join binary archive chunks back into a single tar archive",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TarJoinArchiveRequestDataType::Fields, {
                    "preselected": True,
                },
            ),
            "output_type": TarJoinArchiveDataProvider::ResponseType,
        });
    };
}

/** @mainpage TarDataProvider Module

    @tableofcontents

    @section tardataproviderintro Introduction to the TarDataProvider Module

    The %TarDataProvider module provides a data provider API for TAR archives through the
    DataProvider API. It exposes archive creation, extraction,
    listing, and streaming operations with optional compression and encryption support.

    The following classes are provided by this module:
    - @ref TarDataProvider::TarDataProvider "TarDataProvider"
    - @ref TarDataProvider::TarDataProviderFactory "TarDataProviderFactory"
    - @ref TarDataProvider::TarArchiveDataProvider "TarArchiveDataProvider"
    - @ref TarDataProvider::TarCreateArchiveDataProvider "TarCreateArchiveDataProvider"
    - @ref TarDataProvider::TarExtractArchiveDataProvider "TarExtractArchiveDataProvider"
    - @ref TarDataProvider::TarListArchiveDataProvider "TarListArchiveDataProvider"
    - @ref TarDataProvider::TarArchiveInfoDataProvider "TarArchiveInfoDataProvider"
    - @ref TarDataProvider::TarAddFilesDataProvider "TarAddFilesDataProvider"
    - @ref TarDataProvider::TarExtractFileDataProvider "TarExtractFileDataProvider"
    - @ref TarDataProvider::TarReadFileDataProvider "TarReadFileDataProvider"
    - @ref TarDataProvider::TarStreamDataProvider "TarStreamDataProvider"
    - @ref TarDataProvider::TarStreamExtractDataProvider "TarStreamExtractDataProvider"
    - @ref TarDataProvider::TarDeleteEntryDataProvider "TarDeleteEntryDataProvider"
    - @ref TarDataProvider::TarEncryptArchiveDataProvider "TarEncryptArchiveDataProvider"
    - @ref TarDataProvider::TarDecryptArchiveDataProvider "TarDecryptArchiveDataProvider"
    - @ref TarDataProvider::TarSplitArchiveDataProvider "TarSplitArchiveDataProvider"
    - @ref TarDataProvider::TarJoinArchiveDataProvider "TarJoinArchiveDataProvider"

    @section tardataprovider_factory TarDataProvider Factory

    The name of the Tar data provider factory is <b><tt>tar</tt></b>.

    @section tardataprovider_examples TarDataProvider Examples

    These examples are with \c qdp, the command-line interface to the Data Provider API.

    @par API Example: Create an Archive
    @verbatim qdp 'tar{}/archive/create' path=archive.tar,files='({name=readme.txt,data="Hello, World!"})'
    @endverbatim

    @par API Example: List Archive Contents
    @verbatim qdp 'tar{}/archive/list' path=archive.tar
    @endverbatim

    @par API Example: Extract an Archive
    @verbatim qdp 'tar{}/archive/extract' path=archive.tar,destination=/tmp/extract,overwrite=true
    @endverbatim
*/

#! Contains all public definitions in the TarDataProvider module
public namespace TarDataProvider {
    #! Application name
    public const AppName = "Tar";

    #! TAR logo
    public const TarLogo = File::readTextFile(get_script_dir() + "/tar-logo.svg");

    #! Compression method enum
    public enum TarCompression : string {
        None = "none",
        Gzip = "gzip",
        Bzip2 = "bzip2",
        Xz = "xz",
        Zstd = "zstd",
        Lz4 = "lz4",
    }

    #! TAR format enum
    public enum TarFormat : string {
        Ustar = "ustar",
        Pax = "pax",
        Gnu = "gnu",
        V7 = "v7",
    }

    #! Mapping from enum/string values to TAR library constants
    public const CompressionMethodMap = {
        TarCompression::None: TAR_CM_NONE,
        TarCompression::Gzip: TAR_CM_GZIP,
        TarCompression::Bzip2: TAR_CM_BZIP2,
        TarCompression::Xz: TAR_CM_XZ,
        TarCompression::Zstd: TAR_CM_ZSTD,
        TarCompression::Lz4: TAR_CM_LZ4,
    };

    #! Mapping from enum/string values to TAR format constants
    public const TarFormatMap = {
        TarFormat::Ustar: TAR_FORMAT_USTAR,
        TarFormat::Pax: TAR_FORMAT_PAX,
        TarFormat::Gnu: TAR_FORMAT_GNU,
        TarFormat::V7: TAR_FORMAT_V7,
    };

    #! List of allowed compression values
    public const AllowedCompressionValues = (
        <AllowedValueInfo>{"value": "none", "display_name": "None"},
        <AllowedValueInfo>{"value": "gzip", "display_name": "Gzip"},
        <AllowedValueInfo>{"value": "bzip2", "display_name": "Bzip2"},
        <AllowedValueInfo>{"value": "xz", "display_name": "XZ/LZMA"},
        <AllowedValueInfo>{"value": "zstd", "display_name": "Zstandard"},
        <AllowedValueInfo>{"value": "lz4", "display_name": "LZ4"},
    );

    #! List of allowed format values
    public const AllowedFormatValues = (
        <AllowedValueInfo>{"value": "ustar", "display_name": "POSIX Ustar"},
        <AllowedValueInfo>{"value": "pax", "display_name": "POSIX Pax"},
        <AllowedValueInfo>{"value": "gnu", "display_name": "GNU Tar"},
        <AllowedValueInfo>{"value": "v7", "display_name": "V7"},
    );

    #! List of common encoding values
    public const AllowedEncodingValues = (
        <AllowedValueInfo>{"value": "UTF-8", "display_name": "UTF-8"},
        <AllowedValueInfo>{"value": "ISO-8859-1", "display_name": "ISO-8859-1 (Latin-1)"},
        <AllowedValueInfo>{"value": "ASCII", "display_name": "ASCII"},
        <AllowedValueInfo>{"value": "UTF-16", "display_name": "UTF-16"},
        <AllowedValueInfo>{"value": "UTF-16BE", "display_name": "UTF-16 Big Endian"},
        <AllowedValueInfo>{"value": "UTF-16LE", "display_name": "UTF-16 Little Endian"},
        <AllowedValueInfo>{"value": "Windows-1252", "display_name": "Windows-1252"},
    );

    #! Helper to get compression method from string or enum
    public int sub getCompressionMethod(auto val) {
        if (!exists val) {
            return TAR_CM_NONE;
        }
        if (val.typeCode() == NT_INT) {
            return int(val);
        }
        string method = string(val).lwr();
        return CompressionMethodMap{method} ?? TAR_CM_NONE;
    }

    #! Helper to get format from string or enum
    public int sub getTarFormat(auto val) {
        if (!exists val) {
            return TAR_FORMAT_PAX;
        }
        if (val.typeCode() == NT_INT) {
            return int(val);
        }
        string fmt = string(val).lwr();
        return TarFormatMap{fmt} ?? TAR_FORMAT_PAX;
    }
}
